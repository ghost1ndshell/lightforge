<Layouts.app flash={@flash} battle_net_connected={@battle_net_connected}>
  <section class="forge-shell space-y-10">
    <div class="forge-hero overflow-hidden rounded-[2rem] border border-amber-200/60 px-6 py-10 shadow-[0_20px_80px_rgba(50,27,14,0.15)] sm:px-8 lg:px-10">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-end">
        <div class="space-y-6">
          <p class="text-xs font-semibold uppercase tracking-[0.4em] text-amber-700/80">
            Lightforge
          </p>
          <div class="space-y-4">
            <h1 class="max-w-4xl text-5xl font-semibold tracking-[-0.05em] text-stone-950 sm:text-6xl">
              A cleaner way to inspect your retail character before the real analytics arrive.
            </h1>
            <p class="max-w-2xl text-base leading-7 text-stone-700">
              Step 1 is intentionally narrow: authenticate with Battle.net, load a current character, and render the gear and media surface that the rest of Lightforge will build on.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <%= if @battle_net_connected do %>
              <.link
                navigate={~p"/character"}
                class="inline-flex items-center justify-center rounded-full bg-stone-950 px-6 py-3 text-sm font-semibold text-white transition hover:bg-stone-800"
              >
                Open character cockpit
              </.link>
            <% else %>
              <.link
                href={~p"/auth/bnet"}
                class="inline-flex items-center justify-center rounded-full bg-stone-950 px-6 py-3 text-sm font-semibold text-white transition hover:bg-stone-800"
              >
                Connect Battle.net
              </.link>
            <% end %>
            <.link
              navigate={~p"/character"}
              class="inline-flex items-center justify-center rounded-full border border-stone-300 bg-white px-6 py-3 text-sm font-semibold text-stone-900 transition hover:border-stone-950"
            >
              Review the cockpit
            </.link>
          </div>
        </div>

        <div class="forge-panel rounded-[1.75rem] p-5">
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-stone-500">Phase 1</p>
          <ul class="mt-4 space-y-4 text-sm leading-6 text-stone-700">
            <li class="flex gap-3">
              <span class="mt-1 flex size-6 items-center justify-center rounded-full bg-amber-100 text-amber-700">
                <.icon name="hero-link" class="size-4" />
              </span>
              OAuth-backed Battle.net login, with in-memory token storage instead of cookie bloat.
            </li>
            <li class="flex gap-3">
              <span class="mt-1 flex size-6 items-center justify-center rounded-full bg-amber-100 text-amber-700">
                <.icon name="hero-user" class="size-4" />
              </span>
              Linked-account character selection by region, without manual typing.
            </li>
            <li class="flex gap-3">
              <span class="mt-1 flex size-6 items-center justify-center rounded-full bg-amber-100 text-amber-700">
                <.icon name="hero-sparkles" class="size-4" />
              </span>
              Spec-aware cockpit with current stats, content snapshot, and source-backed stat priorities.
            </li>
          </ul>
        </div>
      </div>
    </div>

    <section class="grid gap-6 lg:grid-cols-3">
      <article class="forge-panel rounded-[1.75rem] p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-stone-500">Now</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-stone-950">
          Snapshot-first
        </h2>
        <p class="mt-3 text-sm leading-6 text-stone-600">
          This slice focuses on trustworthy character state: current gear, class/spec identity, and media assets.
        </p>
      </article>

      <article class="forge-panel rounded-[1.75rem] p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-stone-500">Next</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-stone-950">
          Loot pathing
        </h2>
        <p class="mt-3 text-sm leading-6 text-stone-600">
          Map current slots to raid and Mythic+ sources, then start layering target gear and upgrade gaps.
        </p>
      </article>

      <article class="forge-panel rounded-[1.75rem] p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.28em] text-stone-500">Later</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-[-0.03em] text-stone-950">
          Parse analytics
        </h2>
        <p class="mt-3 text-sm leading-6 text-stone-600">
          Warcraft Logs integration, encounter analysis, and spec-strength recommendations belong after the snapshot foundation is stable.
        </p>
      </article>
    </section>
  </section>
</Layouts.app>
